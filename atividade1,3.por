programa
{
	
	funcao inicio()
	{
		cadeia nome, idade
	
		escreva("Digite o seu nome: ")
		leia(nome)
		escreva("Digite o seu nome: ")
		leia(idade)

		escreva("Olá, ", nome ,", sua idade é: ", idade)
	}
}

