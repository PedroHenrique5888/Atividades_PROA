programa
{
	
	funcao inicio()
{
		para (inteiro f=15; f<=100; f++)
		para (inteiro i=15; i<=100; i++)		
		para (inteiro c=15; c<=100; c++)
		{
		se(i == 100 e c == 100)
		{
			inteiro media = (c+i)/f
			escreva(media,"\n")
		}
		}
		
		
   			
}
}

