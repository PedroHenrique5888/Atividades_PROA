programa  
{  
    funcao inicio()  
    { 
	real i
	
		escreva("Digite o primeiro número: ")
		leia(i)
		
    		se(i == 0)
   	 	{
    		escreva("Numero é zero")
		}
   		senao se (i >= 1)
   		{
   			escreva("Numero é psitivo")
   		}
   		senao
   		{
   			escreva("Numero negativo")
   		}
 }  
}  
