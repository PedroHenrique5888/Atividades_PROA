programa
{ // Leia 10 valores e informe quantos estão no intervalo de 24 a 42 (inclusive) e quantos estão fora.
	
	funcao inicio()
	{
		inteiro n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, i = 0, n = 0

		escreva("Digite o primeiro número: ")
		leia(n1)
		escreva("Digite o segundo número: ")
		leia(n2)	
		escreva("Digite o terceiro número: ")
		leia(n3)
		escreva("Digite o quato número: ")
		leia(n4)	
		escreva("Digite o quinto número: ")
		leia(n5)
		escreva("Digite o sexto número: ")
		leia(n6)	
		escreva("Digite o setimo número: ")
		leia(n7)
		escreva("Digite o oitavo número: ")
		leia(n8)	
		escreva("Digite o nono número: ")
		leia(n9)
		escreva("Digite o decimo número: ")
		leia(n10)
		
	se(n1 >= 24 e n1 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}

   	 se(n2 >= 24 e n2 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}

   	 se(n3 >= 24 e n3 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}

   	 se(n4 >= 24 e n4 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}

   	se(n5 >= 24 e n5 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}

	 se(n6 >= 24 e n6 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}

   	 se(n7 >= 24 e n7 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}

   	 se(n8 >= 24 e n8 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}

   	 se(n9 >= 24 e n9 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}

   	 se(n10 >= 24 e n10 <= 42)
   	 	{
			i = i +1
   	 	}
   	 	senao
   	 	{
   	 		n = n + 1
   	 	}
   	 	
   	 	escreva("Quantidade de valores que estão no intervalo de 24 a 42: ", i , "\n")
   	 	
   	 	escreva("Quantidade de valores que estão fora do intervalo de 24 a 42: ", n , "\n")
   	 	
		escreva("", n1 ," ", n2 ," ", n3 ," ", n4 ," ", n5 ," ", n6 ," ",
		n7 ," ", n8 ," ", n9 ," ", n10 , "\n")
   	 	
	}
}
